# Copy to .env and fill in real values. Vars must be prefixed BUN_PUBLIC_
# (see bunfig.toml [serve.static] env) to be exposed to client-side code.
BUN_PUBLIC_DEEPGRAM_API_KEY=
# Public URL of the deployed backend (e.g. https://your-backend.up.railway.app).
# Defaults to http://localhost:3001 for local dev if unset.
BUN_PUBLIC_BACKEND_URL=
